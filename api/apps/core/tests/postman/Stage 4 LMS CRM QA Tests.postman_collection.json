                "type": "text/javascript",
                "exec": [
                  "pm.test('Status code is 200 OK', function () {",
                  "  pm.response.to.have.status(200);",
                  "});",
                  "pm.test('Response time is under 500ms', function () {",
                  "  pm.expect(pm.response.responseTime).to.be.below(500);",
                  "});",
                  "const schema = {",
                  "  type: 'object',",
                  "  required: ['message', 'user'],",
                  "  properties: {",
                  "    message: { type: 'string' },",
                  "    user: { type: 'object' }",
                  "  }",
                  "};",
                  "pm.test('Login response schema is valid', function () {",
                  "  pm.response.to.have.jsonSchema(schema);",
                  "});",
                  "const json = pm.response.json();",
                  "pm.test('Login returns success message', function () {",
                  "  pm.expect(json.message).to.eql('success');",
                  "});",
                  "const accessCookie = pm.cookies.get('access-token');",
                  "if (accessCookie) {",
                  "  pm.collectionVariables.set('access_token', accessCookie);",
                  "}",
                  "if (json.access) {",
                  "  pm.collectionVariables.set('access_token', json.access);",
                  "}"
                ]
              }
            }
