{
  "info": {
    "name": "UniSchoolLMS - Massive Load Test",
    "description": "Комплексне навантажувальне тестування (25 ендпоінтів: 1 Login + 24 GET-запити до різних модулів).",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json"
  },
  "event": [
    {
      "listen": "test",
      "script": {
        "type": "text/javascript",
        "exec": [
          "pm.test(\"System did not crash (status < 500)\", function () {",
          "    pm.expect(pm.response.code).to.be.below(500);",
          "});"
        ]
      }
    }
  ],
  "variable": [
    {
      "key": "base_url",
      "value": "http://localhost:8000",
      "type": "string"
    },
    {
      "key": "access_token",
      "value": "",
      "type": "string"
    }
  ],
  "item": [
    {
      "name": "1. Логін (Login)",
      "event": [
        {
          "listen": "test",
          "script": {
            "exec": [
              "// ПЕРЕХОПЛЕННЯ JWT ТОКЕНА З КУКІ",
              "let headers = pm.response.headers.all();",
              "let accessToken = null;",
              "for (let i = 0; i < headers.length; i++) {",
              "    if (headers[i].key.toLowerCase() === \"set-cookie\" && headers[i].value.includes(\"access-token=\")) {",
              "        accessToken = headers[i].value.split(\"access-token=\")[1].split(\";\")[0];",
              "        break;",
              "    }",
              "}",
              "if (accessToken) {",
              "    pm.collectionVariables.set(\"access_token\", accessToken);",
              "}"
            ],
            "type": "text/javascript"
          }
        }
      ],
      "request": {
        "method": "POST",
        "header": [
          { "key": "Content-Type", "value": "application/json" }
        ],
        "body": {
          "mode": "raw",
          "raw": "{\n  \"email\": \"bananbka0.2@gmail.com\",\n  \"password\": \"qweqweqwe\"\n}"
        },
        "url": {
          "raw": "{{base_url}}/auth/login/",
          "host": ["{{base_url}}"],
          "path": ["auth", "login", ""]
        }
      }
    },
    {
      "name": "2. Профіль (Profile)",
      "request": {
        "method": "GET",
        "header": [{ "key": "Cookie", "value": "access-token={{access_token}}", "type": "text" }],
        "url": { "raw": "{{base_url}}/profile/me/", "host": ["{{base_url}}"], "path": ["profile", "me", ""] }
      }
    },
    {
      "name": "3. Користувачі (Users)",
      "request": {
        "method": "GET",
        "header": [{ "key": "Cookie", "value": "access-token={{access_token}}", "type": "text" }],
        "url": { "raw": "{{base_url}}/users/", "host": ["{{base_url}}"], "path": ["users", ""] }
      }
    },
