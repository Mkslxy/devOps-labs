# Enforce LF line endings for all shell scripts
*.sh text eol=lf
entrypoint.sh text eol=lf

# Enforce LF line endings for Helm chart, YAML, and Markdown (Requirement A.1)
*.yaml text eol=lf
*.yml text eol=lf
*.tpl text eol=lf
*.md text eol=lf
*.txt text eol=lf
Chart.yaml text eol=lf
.helmignore text eol=lf
